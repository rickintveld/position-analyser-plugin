#!/usr/bin/env zsh

# rocket: the deterministic part of /rocket:analyse.
#
# It finds the MetaTrader 5 terminals on this machine, decodes their logs,
# rebuilds the trades (lib/events.awk, lib/trades.jq), computes the statistics
# (lib/stats.jq) and keeps one pipeline per run that the pane
# (hooks/register.tsx) draws. Read-only towards MetaTrader: it only reads
# logs and writes under $ROCKET_HOME.

set -o errexit   # abort on nonzero exitstatus
set -o pipefail  # don't hide errors within pipes
set -o nounset   # abort on unbound variable

PA_HOME=${ROCKET_HOME:-$HOME/.config/rocket}
PLUGIN_ROOT=${0:A:h:h}
LIB=$PLUGIN_ROOT/lib
RUNS=$PA_HOME/runs
CURRENT=$PA_HOME/current

JOB_STATUSES=(pending running success failed warning skipped canceled)

die() {
    print -u2 -- "rocket: $*"
    exit 1
}

now() {
    date +%s
}

need() {
    local tool
    for tool in "$@"; do
        command -v $tool >/dev/null || die "$tool is required (macOS 15+ ships jq; otherwise: brew install jq)"
    done
}

# Atomic JSON edit under a mkdir lock: parallel calls would otherwise lose writes.
jq_edit() {
    local file=$1; shift
    local lock=$file.lock tmp=$file.tmp.$$ tries=0
    until mkdir "$lock" 2>/dev/null; do
        if (( ++tries > 100 )); then
            rm -rf "$lock"  # stale lock, ~5 seconds old
            tries=0
        fi
        sleep 0.05
    done
    if jq "$@" "$file" > "$tmp"; then
        mv "$tmp" "$file"
        rmdir "$lock"
    else
        rm -f "$tmp"
        rmdir "$lock"
        return 1
    fi
}

# --- dates -------------------------------------------------------------------

# YYYY-MM-DD or YYYYMMDD -> YYYY-MM-DD
day() {
    local d=${1//-/}
    [[ $d == <-> && ${#d} == 8 ]] || die "not a date: $1 (use YYYY-MM-DD)"
    d=${d:0:4}-${d:4:2}-${d:6:2}
    # a real calendar day: parsed and printed back unchanged
    [[ $(date -j -f %Y-%m-%d $d +%Y-%m-%d 2>/dev/null || date -d $d +%Y-%m-%d 2>/dev/null) == $d ]] \
        || die "not a date: $1"
    print -- $d
}

# day +/-N days (BSD date on macOS, GNU date elsewhere)
shift_day() {
    date -j -v${2}d -f %Y-%m-%d $1 +%Y-%m-%d 2>/dev/null || date -d "$1 ${2} days" +%Y-%m-%d
}

today() {
    date +%Y-%m-%d
}

# --- run state ---------------------------------------------------------------

run_dir() {
    [[ -f $CURRENT ]] || die "no run; start one with: rocket run start"
    local id=$(<$CURRENT)
    [[ -d $RUNS/$id ]] || die "run $id not found"
    print -- $RUNS/$id
}

status_file() {
    print -- $(run_dir)/status.json
}

job() {
    local id=${1:-} st=${2:-} note=${3-}
    [[ -n $id && -n $st ]] || die "usage: job <id> <status> [note]"
    (( ${JOB_STATUSES[(Ie)$st]} )) || die "unknown status $st (${JOB_STATUSES[*]})"
    local file=$(status_file)
    jq -e --arg id $id '.jobs[$id]' $file >/dev/null || die "unknown job $id"
    jq_edit $file --arg id $id --arg st $st --arg note "$note" --argjson now $(now) '
        .jobs[$id] |= (
            .status = $st | .note = $note
            | if $st == "running" then .started_at = $now | .finished_at = null
              elif $st == "pending" then .started_at = null | .finished_at = null
              else .started_at = (.started_at // $now) | .finished_at = $now end)
        | .updated_at = $now
        | .active_stage = (if $st == "running" then (.stages[] | select(.jobs | index($id)) | .name) else .active_stage end)'
}

run_start() {
    local from='' to=''
    local -a accounts
    while (( $# )); do
        case $1 in
            --account)
                [[ ${2:-} == <-> ]] || die "--account takes an account number (digits), got '${2:-}'"
                accounts+=$2; shift 2 ;;
            --date) from=$(day $2); to=$from; shift 2 ;;
            --from) from=$(day $2); shift 2 ;;
            --to) to=$(day $2); shift 2 ;;
            *) die "unknown option $1" ;;
        esac
    done
    [[ -n $from ]] || from=$(today)
    [[ -n $to ]] || to=$(today)
    [[ $from > $to ]] && die "--from $from is after --to $to"

    local id=$(date +%Y%m%d-%H%M%S) n=1
    while [[ -e $RUNS/$id ]]; do id=$(date +%Y%m%d-%H%M%S)-$(( n++ )); done
    mkdir -p $RUNS/$id
    jq -n --arg id $id --arg from $from --arg to $to --argjson now $(now) \
        --argjson accounts "$(print -l -- $accounts | jq -R -s 'split("\n") | map(select(. != ""))')" '
        def job: {status: "pending", note: "", started_at: null, finished_at: null};
        {
            id: $id, range: {from: $from, to: $to}, accounts: $accounts,
            status: "running", active_stage: "discover", summary: "", notes: [],
            started_at: $now, updated_at: $now, finished_at: null,
            stages: [
                {name: "discover", jobs: ["terminals"]},
                {name: "read", jobs: ["journal", "experts"]},
                {name: "parse", jobs: ["events", "trades", "failed"]},
                {name: "analyse", jobs: ["pnl", "stats"]},
                {name: "report", jobs: ["table", "story"]}
            ],
            jobs: ({} | .terminals = job | .journal = job | .experts = job | .events = job | .trades = job
                      | .failed = job | .pnl = job | .stats = job | .table = job | .story = job)
        }' > $RUNS/$id/status.json
    print -- $id > $CURRENT
    jq -c --arg dir $RUNS/$id '{run: .id, dir: $dir, range, accounts}' $RUNS/$id/status.json
}

run_note() {
    jq_edit $(status_file) --arg text "${1:?usage: run note <text>}" --argjson now $(now) \
        '.notes = (.notes + [{at: $now, text: $text}])[-20:] | .updated_at = $now'
}

run_finish() {
    local st=${1:-} summary=${2-}
    [[ $st == (success|failed|canceled) ]] || die "usage: run finish success|failed|canceled [summary]"
    jq_edit $(status_file) --arg st $st --arg summary "$summary" --argjson now $(now) '
        .jobs |= map_values(
            if .status == "running" then .status = "canceled" | .finished_at = $now
            elif .status == "pending" then .status = "skipped" else . end)
        | .status = $st | .summary = $summary | .finished_at = $now | .updated_at = $now'
}

# --- the steps ---------------------------------------------------------------

# Data folders of every MT5 terminal: folders with terminal64.exe (portable
# installs, the MetaQuotes wine app, CrossOver bottles) and the per-user data
# folders under AppData/Roaming/MetaQuotes/Terminal/<id>, each with a logs folder.
find_terminals() {
    local -a roots found
    local root exe
    # wine prefixes (the MetaQuotes app, CrossOver bottles, ~/.wine, other
    # wrappers) hold a drive_c; ROCKET_MT5_PATHS replaces the search
    if [[ -n ${ROCKET_MT5_PATHS:-} ]]; then
        roots=(${(s.:.)ROCKET_MT5_PATHS})  # the user's folders replace the search
    else
        roots=("${(@f)$(find "$HOME/Library/Application Support" "$HOME/.wine" -maxdepth 4 -type d -name drive_c 2>/dev/null || true)}")
    fi
    for root in $roots; do
        [[ -n $root && -d $root ]] || continue
        found+=("${(@f)$(find "$root" -maxdepth 8 \( -name terminal64.exe -o -name origin.txt \) 2>/dev/null || true)}")
    done
    for exe in $found; do
        [[ -n $exe && -d ${exe:h}/logs ]] && print -- ${exe:h}
    done | sort -u
    return 0
}

cmd_discover() {
    local dir=$(run_dir)
    job terminals running "looking for MetaTrader 5 data folders"
    local -a terms=("${(@f)$(find_terminals)}")
    terms=(${terms:#})
    if (( ! ${#terms} )); then
        job terminals failed "no MetaTrader 5 terminal found"
        die "no terminal found; set ROCKET_MT5_PATHS=<folder>[:<folder>] to the folder holding terminal64.exe"
    fi
    print -l -- $terms | jq -R -s --arg home "$HOME" '
        split("\n") | map(select(. != "")) | to_entries | map({
            index: .key, path: .value,
            label: (.value | sub("^" + $home + "/"; "") | sub("^.*Application Support/"; "") | sub("/drive_c/.*"; "")
                    | if test("/AppData/") then . + " (" + (split("/") | last | .[0:8]) + ")" else . end)
        })' > $dir/terminals.json
    job terminals success "${#terms} terminal(s): $(jq -r 'map(.label) | join(", ")' $dir/terminals.json)"
    cat $dir/terminals.json
}

cmd_read() {
    local dir=$(run_dir) file=$(status_file)
    [[ -f $dir/terminals.json ]] || die "run discover first"
    local from=$(jq -r .range.from $file) to=$(jq -r .range.to $file)
    # one day either side, for positions that run over midnight
    local d=$(shift_day $from -1) last=$(shift_day $to +1)
    local -a days
    while [[ ! $d > $last ]]; do days+=${d//-/}; d=$(shift_day $d +1); done

    job journal running "decoding journals ${from} → ${to}"
    job experts running "decoding expert logs"
    local i tpath kind src name count_j=0 count_e=0
    for i tpath in "${(@f)$(jq -r '.[] | .index, .path' $dir/terminals.json)}"; do
        for kind src in journal logs experts MQL5/Logs; do
            mkdir -p $dir/logs/$i/$kind
            for name in $days; do
                [[ -f $tpath/$src/$name.log ]] || continue
                iconv -f UTF-16LE -t UTF-8 $tpath/$src/$name.log > $dir/logs/$i/$kind/$name.log 2>/dev/null \
                    || cp $tpath/$src/$name.log $dir/logs/$i/$kind/$name.log  # already UTF-8
                [[ $kind == journal ]] && (( ++count_j )) || (( ++count_e ))
            done
        done
    done
    if (( count_j == 0 )); then
        job journal warning "no journal for ${from} → ${to}"
    else
        job journal success "$count_j day log(s) decoded"
    fi
    if (( count_e == 0 )); then
        job experts skipped "no expert logs in this period"
    else
        job experts success "$count_e expert log(s), for context"
    fi
    jq -n --argjson journal $count_j --argjson experts $count_e '{journal: $journal, experts: $experts}'
}

cmd_parse() {
    local dir=$(run_dir) file=$(status_file) contracts='{}'
    while (( $# )); do
        case $1 in
            --contract)
                [[ ${2:-} == *=<->* || ${2:-} == *=<->.<-> ]] || die "--contract SYMBOL=size, e.g. US30=1"
                contracts=$(jq -c --arg s ${2%%=*} --argjson v ${2#*=} '.[$s] = $v' <<< $contracts)
                shift 2 ;;
            *) die "unknown option $1" ;;
        esac
    done
    [[ -d $dir/logs ]] || die "run read first"

    job events running "reading Trades and Network lines"
    : > $dir/events.jsonl
    local log name i
    for log in $dir/logs/*/journal/*.log(N); do
        name=${log:t:r}
        i=${log:h:h:t}
        awk -v date=${name:0:4}-${name:4:2}-${name:6:2} -v terminal=$i -f $LIB/events.awk $log >> $dir/events.jsonl
    done
    job events success "$(wc -l < $dir/events.jsonl | tr -d ' ') events"

    job trades running "rebuilding positions"
    jq -s --arg from $(jq -r .range.from $file) --arg to $(jq -r .range.to $file) --argjson contracts $contracts \
        --argjson only "$(jq -c '.accounts // []' $file)" -f $LIB/trades.jq $dir/events.jsonl > $dir/trades.json
    local missing=$(jq -r '.only - .seen | join(", ")' $dir/trades.json)
    if [[ -n $missing ]]; then
        job trades warning "account $missing not in the logs of this period; seen: $(jq -r '.seen | join(", ") | if . == "" then "none" else . end' $dir/trades.json)"
        jq -c '{accounts, trades: (.trades | length), missing: (.only - .seen), seen}' $dir/trades.json
        return 0
    fi
    job trades success "$(jq -r '"\(.trades | length) trade(s) on \(.accounts | length) account(s)\(
        (.trades | map(select(.status == "open")) | length) as $o | if $o > 0 then ", \($o) still open" else "" end)"' $dir/trades.json)"

    local failed=$(jq '.failed | length' $dir/trades.json)
    if (( failed > 0 )); then
        job failed warning "$failed failed order(s): $(jq -r '.failed | map(.reason) | group_by(.) | map("\(length)× \(.[0])") | join(", ")' $dir/trades.json)"
    else
        job failed success "none"
    fi
    jq -c '{accounts, trades: (.trades | length), open: (.trades | map(select(.status == "open")) | length), failed: (.failed | length)}' $dir/trades.json
}

cmd_analyse() {
    local dir=$(run_dir)
    [[ -f $dir/trades.json ]] || die "run parse first"
    job pnl running "P/L from contract sizes"
    local unknown=$(jq -r '.trades | map(select(.contract == null) | .symbol) | unique | join(", ")' $dir/trades.json)
    local defaults=$(jq -r '.trades | map(select(.contract_source == "default") | "\(.symbol) \(.contract)") | unique | join(", ")' $dir/trades.json)
    if [[ -n $unknown ]]; then
        job pnl warning "contract size unknown: $unknown (parse --contract SYMBOL=size)"
    else
        job pnl success "estimate without commission/swap${defaults:+; default size: $defaults}"
    fi
    job stats running "win rate, RRR, symbols, hours, buy/sell"
    jq -f $LIB/stats.jq $dir/trades.json > $dir/stats.json
    job stats success "$(jq -r '.groups[0] | if . == null then "no trades" else "\(.closed) closed · win rate \(.win_rate // "–")%\(if .net != null then " · net \(.net) \(.currency)" else "" end)" end' $dir/stats.json)"
    cat $dir/stats.json
}

# Markdown tables per account, for the report.
cmd_table() {
    local dir=$(run_dir)
    [[ -f $dir/trades.json ]] || die "run parse first"
    jq -r '
        def n: if . == null then "unknown" else tostring end;
        def t: if . == null then "unknown" else .[11:16] + " (" + .[5:10] + ")" end;
        def how: if . == null then "still open" else {manual: "manual", sl: "SL", tp: "TP", stop_out: "stop out"}[.] // . end;
        def pnl: if .pnl == null then "unknown" else "≈ \(.pnl) \(.currency)" end;
        . as $all
        | $all.accounts[] | .account as $a
        | "### \($a) · \([.broker, .server] | map(select(. != null)) | join(" · "))\n",
          "| # | open | side | symbol | lots | entry | exit | closed | how | P/L |",
          "|---|---|---|---|---|---|---|---|---|---|",
          ($all.trades | map(select(.account == $a)) | to_entries[] | .key as $k | .value
           | "| \($k + 1) | \(.open_at | t) | \(.side) | \(.symbol) | \(.volume | n) | \(.entry | n) | \(.exit | n) | \(.close_at | t) | \(.closed_by | how) | \(pnl) |"),
          ""
    ' $dir/trades.json
}

# --- main --------------------------------------------------------------------

need jq awk iconv
mkdir -p $RUNS

case ${1:-help} in
    run)
        case ${2:-} in
            start) shift 2; run_start "$@" ;;
            status) cat $(status_file) ;;
            note) run_note "${3-}" ;;
            finish) run_finish "${3:-}" "${4-}" ;;
            dir) run_dir ;;
            *) die "usage: run start|status|note|finish|dir" ;;
        esac ;;
    job) shift; job "$@" ;;
    discover) cmd_discover ;;
    read) cmd_read ;;
    parse) shift; cmd_parse "$@" ;;
    analyse) cmd_analyse ;;
    table) cmd_table ;;
    terminals) find_terminals ;;
    help|-h|--help)
        cat <<'EOF'
rocket: MetaTrader 5 trades from the terminal logs (read-only)

  run start [--date D | --from D --to D] [--account N ...]
                                            new run (default: today, all accounts), becomes current
  run status | dir                          the current run's status.json / folder
  run note <text>                           a milestone note in the pane
  run finish success|failed|canceled [summary]
  job <id> <status> [note]                  status: pending running success failed warning skipped canceled

  discover                                  find MT5 terminals          (stage discover)
  read                                      decode journal + expert logs (stage read)
  parse [--contract SYMBOL=size ...]        rebuild trades               (stage parse)
  analyse                                   statistics -> stats.json     (stage analyse)
  table                                     markdown trade table per account

  terminals                                 list MT5 data folders found

State: $ROCKET_HOME (default ~/.config/rocket).
Search only these folders: ROCKET_MT5_PATHS=<folder>[:<folder>].
EOF
        ;;
    *) die "unknown command $1 (see: rocket help)" ;;
esac
